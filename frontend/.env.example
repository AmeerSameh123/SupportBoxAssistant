# Frontend environment. Copy to `.env.local`.
#
# In development this can stay empty: vite.config.ts proxies /api to the backend,
# so the demo path needs no CORS relaxation at all (PRD §10.4).
VITE_API_BASE_URL=

# Only needed if the backend has API_TOKEN set. Note this is a build-time value
# and therefore visible to anyone with the bundle — another reason the bearer
# token is a doorstop rather than authentication.
VITE_API_TOKEN=
