# Support Inbox Assistant — environment configuration
#
# Copy to `.env` and adjust. `.env` is gitignored and must never be committed.
# Every variable below is read in exactly one place: backend/app/core/config.py.
# Nothing else in the codebase touches os.environ (PRD §13).

# ---------------------------------------------------------------------------
# LLM — required by the brief. Any OpenAI-compatible endpoint works.
# ---------------------------------------------------------------------------
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2:3b
# Ollama requires the field and ignores the value. A real provider needs a real
# key here — which is exactly why .env is gitignored (PRD §10.1).
LLM_API_KEY=ollama

# How the JSON schema is requested: json_schema | json_object | none
#   json_schema - OpenAI strict schema. The DEFAULT, chosen on measured evidence:
#                 the Day-0 spike found Ollama 0.32.6 honours it, fixing 4/4 of
#                 the reproducible schema-echo failures and running ~2x faster
#                 on them. See README "What the spike found".
#   json_object - universally supported fallback for endpoints that ignore
#                 json_schema. Under this mode ~20% of tickets need repair.
#   none        - pure prompting; proves the repair layer standing alone.
# The repair layer runs in every mode. Constrained decoding is an optimization,
# never the guarantee.
LLM_RESPONSE_FORMAT=json_schema

LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
# Bounded concurrency is FASTER than unbounded against one CPU-bound Ollama.
LLM_CONCURRENCY=2
LLM_TEMPERATURE=0
LLM_SEED=42
LLM_MAX_TOKENS=700
# Hard cap on the response body before it is parsed (OWASP API10).
LLM_MAX_RESPONSE_BYTES=65536

# Circuit breaker: after N consecutive transport failures, skip the LLM entirely
# for COOLDOWN seconds and go straight to the heuristic fallback. Without this,
# "Ollama isn't running" turns a 30-ticket eval into 15 minutes of timeouts.
LLM_BREAKER_THRESHOLD=3
LLM_BREAKER_COOLDOWN_SECONDS=30

# ---------------------------------------------------------------------------
# Triage policy
# ---------------------------------------------------------------------------
ESCALATE_CONFIDENCE_THRESHOLD=0.55
MIN_SIGNAL_CHARS=15
CONFIDENCE_MODE=self_reported

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
DATA_DIR=./data
CACHE_ENABLED=true
CACHE_DIR=./.cache/triage

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# production disables /docs and /openapi.json and requires API_TOKEN.
APP_ENV=development
# Empty in development = auth disabled. A shared bearer token is not real
# authentication; it is a doorstop. See README limitations.
API_TOKEN=
FRONTEND_ORIGIN=http://localhost:5173
MAX_REQUEST_BYTES=32768
RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=INFO
